package FinSc-Ecology-Wiki
version = 0.1.0
authors = "Justin Kelly"
brief   = "Layer 15 Ecosystem Dynamics & Trophic Energy Verification Suite"

depends = FinSc-Electromagnetism, FinSc-Geometry, FinSc-Multiset, FinSc-Metric-Substrate, FinSc-Phase-Unfolding, FinSc-Thermodynamics, base, idris2-QuickCheck, linear
sourcedir = "Library"

modules = Wiki.Main,
          Wiki.Observations.PhylogeneticTree,
          Wiki.Observations.PredatorPreyDynamics,
          Wiki.Observations.ThermodynamicEcology,
          Wiki.Observations.TrophicEnergyFlow

main = Wiki.Main
executable = ecology-wiki
