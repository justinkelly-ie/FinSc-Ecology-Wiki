package FinSc-Ecology-Wiki
version = 0.1.0
authors = "Justin Kelly"
brief   = "Discrete Ecosystem Dynamics, Population Multisets, Trophic Energy & Evolutionary Phylogeny Wiki"

depends = FinSc-Electromagnetism, FinSc-Geometry, FinSc-Multiset, FinSc-Metric-Substrate, FinSc-Multiset-Transform, FinSc-Thermodynamics, base, idris2-QuickCheck, linear
sourcedir = "Library"

modules = Wiki.Main,
          Wiki.Observations.PhylogeneticTree,
          Wiki.Observations.PredatorPreyDynamics,
          Wiki.Observations.ThermodynamicEcology,
          Wiki.Observations.TrophicEnergyFlow

main = Wiki.Main
executable = ecology-wiki
